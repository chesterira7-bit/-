def scan_passwords(user_passwords, wordlist):
    weak_passwords_set = set(wordlist)
    weak_users = []

    print("Сканування слабких паролів...\n")

    for username, password in user_passwords.items():
        if password in weak_passwords_set:
            print(f"Слабкий пароль     | Користувач: {username}, Пароль: {password}")
            weak_users.append(username)
        else:
            print(f"Складний пароль    | Користувач: {username}, Пароль: {password}")

    return weak_users

WEAK_PASSWORDS = [
    "123456",
    "password",
    "qwerty",
    "dragon",
    "admin",
    "sofia123",
    "ira123",
    "cyb1borg",
